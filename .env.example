require('dotenv').config();
const express = require('express');
const session = require('express-session');
const multer = require('multer');
const path = require('path');
const fs = require('fs/promises');
const crypto = require('crypto');

const app = express();
const PORT = process.env.PORT || 3000;
const DATA_FILE = path.join(__dirname, 'data', 'data.json');
const UPLOAD_DIR = path.join(__dirname, 'uploads', 'audio');
const ADMIN_EMAIL = process.env.ADMIN_EMAIL || 'admin@zaafat.com';
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || 'zaafat2024';

app.set('view engine', 'ejs');
app.set('views', path.join(__dirname, 'views'));
app.use(express.urlencoded({ extended: true }));
app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));
app.use('/uploads', express.static(path.join(__dirname, 'uploads')));
app.use(
  session({
    secret: process.env.SESSION_SECRET || 'zaafat-audio-secret',
    resave: false,
    saveUninitialized: false,
    cookie: { httpOnly: true, secure: false, sameSite: 'lax' },
  })
);

const baseData = {
  siteName: 'زفات أطياف',
  whatsappNumber: '966500856597',
  pricing: {
    newWords: 1000,
    edit: 500,
  },
  categories: [
    { id: 'zafat-arous', name: 'زفات عروس', files: [] },
    { id: 'zafat-aris', name: 'زفات عريس', files: [] },
    { id: 'zafat-molooda', name: 'زفات مولودة', files: [] },
    { id: 'zafat-molod', name: 'زفات مولود', files: [] },
    { id: 'zafat-takhroj-bint', name: 'زفات تخرج بنت', files: [] },
    { id: 'zafat-takhroj-walad', name: 'زفات تخرج ولد', files: [] },
    { id: 'zafat-eid-milad', name: 'زفات عيد ميلاد', files: [] },
    { id: 'zafat-aqd-quran', name: 'زفات عقد قران', files: [] },
    { id: 'zafat-zikra-zawaj', name: 'زفات ذكرى زواج', files: [] },
  ],
  artists: [
    'الفنان حسين الجسمي',
    'الفنان محمد عبده',
    'الفنان إبراهيم عباس',
    'الفنان ماجد المهندس',
    'الفنان عايل القطري',
    'الفنان عايض',
    'الفنان فؤاد عبدالواحد',
    'الفنان جابر الكاسر',
  ],
};

async function ensureFiles() {
  await fs.mkdir(path.dirname(DATA_FILE), { recursive: true });
  await fs.mkdir(UPLOAD_DIR, { recursive: true });

  try {
    await fs.access(DATA_FILE);
  } catch (error) {
    await fs.writeFile(DATA_FILE, JSON.stringify(baseData, null, 2), 'utf8');
  }
}

async function readData() {
  const raw = await fs.readFile(DATA_FILE, 'utf8');
  return JSON.parse(raw);
}

async function writeData(data) {
  await fs.writeFile(DATA_FILE, JSON.stringify(data, null, 2), 'utf8');
}

const storage = multer.diskStorage({
  destination: async function (req, file, cb) {
    try {
      await fs.mkdir(UPLOAD_DIR, { recursive: true });
      cb(null, UPLOAD_DIR);
    } catch (error) {
      cb(error);
    }
  },
  filename: function (req, file, cb) {
    const ext = path.extname(file.originalname || 'audio.mp3');
    const randomId = crypto.randomBytes(4).toString('hex');
    cb(null, `${Date.now()}-${randomId}${ext}`);
  },
});

const upload = multer({
  storage,
  limits: { fileSize: 30 * 1024 * 1024 },
  fileFilter: function (req, file, cb) {
    if (file.mimetype.startsWith('audio/')) {
      cb(null, true);
    } else {
      cb(new Error('يُسمح بملفات صوتية فقط.'));
    }
  },
});

function requireAdmin(req, res, next) {
  if (req.session && req.session.isAdmin) {
    return next();
  }

  return res.redirect('/admin/login');
}

function formatWhatsAppLink(number, fileName, categoryName) {
  const text = `السلام عليكم، أود طلب الزفة التالية: ${categoryName} - ${fileName}.`;
  const encodedText = encodeURIComponent(text);
  return `https://wa.me/${number}?text=${encodedText}`;
}

app.use((req, res, next) => {
  res.locals.siteName = 'زفات أطياف';
  res.locals.whatsappNumber = '966500856597';
  next();
});

app.get('/', async (req, res) => {
  try {
    const data = await readData();
    res.render('index', { categories: data.categories, artists: data.artists, pricing: data.pricing });
  } catch (error) {
    res.status(500).send('حدث خطأ أثناء تحميل الصفحة الرئيسية.');
  }
});

app.get('/category/:slug', async (req, res) => {
  try {
    const data = await readData();
    const category = data.categories.find((item) => item.id === req.params.slug);

    if (!category) {
      return res.status(404).render('not-found', { message: 'القسم غير موجود.' });
    }

    return res.render('category', {
      category,
      whatsappNumber: data.whatsappNumber,
      pricing: data.pricing,
      artistList: data.artists,
    });
  } catch (error) {
    return res.status(500).send('تعذر فتح القسم المطلوب.');
  }
});

app.get('/artists', async (req, res) => {
  try {
    const data = await readData();
    res.render('artists', { artists: data.artists, pricing: data.pricing, whatsappNumber: data.whatsappNumber });
  } catch (error) {
    res.status(500).send('حدث خطأ أثناء تحميل قسم الفنانين.');
  }
});

app.get('/pricing', async (req, res) => {
  try {
    const data = await readData();
    res.render('pricing', { pricing: data.pricing, whatsappNumber: data.whatsappNumber, categories: data.categories });
  } catch (error) {
    res.status(500).send('تعذر تحميل الأسعار.');
  }
});

app.get('/admin/login', (req, res) => {
  if (req.session.isAdmin) {
    return res.redirect('/admin');
  }

  return res.render('admin-login', { error: null });
});

app.post('/admin/login', (req, res) => {
  const { email, password } = req.body;

  if (email === ADMIN_EMAIL && password === ADMIN_PASSWORD) {
    req.session.isAdmin = true;
    return res.redirect('/admin');
  }

  return res.render('admin-login', { error: 'بيانات الدخول غير صحيحة.' });
});

app.get('/admin', requireAdmin, async (req, res) => {
  try {
    const data = await readData();
    res.render('admin-dashboard', { data, error: null, success: null });
  } catch (error) {
    res.status(500).send('تعذر فتح لوحة التحكم.');
  }
});

app.get('/admin/logout', (req, res) => {
  req.session.destroy(() => {
    res.redirect('/admin/login');
  });
});

app.post('/admin/upload', requireAdmin, upload.single('audioFile'), async (req, res) => {
  try {
    const { categoryId, title } = req.body;
    const data = await readData();

    if (!categoryId || !title || !req.file) {
      return res.render('admin-dashboard', {
        data,
        error: 'يرجى اختيار القسم واسم الملف وإرفاق ملف صوتي صالح.',
        success: null,
      });
    }

    const category = data.categories.find((item) => item.id === categoryId);
    if (!category) {
      return res.render('admin-dashboard', {
        data,
        error: 'القسم المحدد غير موجود.',
        success: null,
      });
    }

    category.files.push({
      id: crypto.randomUUID(),
      title,
      filePath: `/uploads/audio/${req.file.filename}`,
      fileName: req.file.originalname,
      createdAt: new Date().toISOString(),
    });

    await writeData(data);

    return res.render('admin-dashboard', {
      data,
      error: null,
      success: 'تم رفع الملف الصوتي بنجاح.',
    });
  } catch (error) {
    const data = await readData();
    return res.render('admin-dashboard', {
      data,
      error: error.message || 'حدث خطأ أثناء رفع الملف الصوتي.',
      success: null,
    });
  }
});

app.post('/admin/delete-audio', requireAdmin, async (req, res) => {
  try {
    const { categoryId, fileId } = req.body;
    const data = await readData();
    const category = data.categories.find((item) => item.id === categoryId);

    if (!category) {
      return res.render('admin-dashboard', {
        data,
        error: 'القسم المحدد غير موجود.',
        success: null,
      });
    }

    const targetFile = category.files.find((file) => file.id === fileId);
    if (!targetFile) {
      return res.render('admin-dashboard', {
        data,
        error: 'الملف المطلوب غير موجود.',
        success: null,
      });
    }

    category.files = category.files.filter((file) => file.id !== fileId);

    const fullFilePath = path.join(__dirname, targetFile.filePath.replace(/^\//, ''));
    try {
      await fs.unlink(fullFilePath);
    } catch (unlinkError) {
      // Ignore missing file if already deleted.
    }

    await writeData(data);

    return res.render('admin-dashboard', {
      data,
      error: null,
      success: 'تم حذف الملف الصوتي بنجاح.',
    });
  } catch (error) {
    const data = await readData();
    return res.render('admin-dashboard', {
      data,
      error: 'حدث خطأ أثناء حذف الملف الصوتي.',
      success: null,
    });
  }
});

app.post('/admin/pricing', requireAdmin, async (req, res) => {
  try {
    const data = await readData();
    const newWords = Number(req.body.newWords || data.pricing.newWords);
    const edit = Number(req.body.edit || data.pricing.edit);

    data.pricing.newWords = Number.isFinite(newWords) ? newWords : data.pricing.newWords;
    data.pricing.edit = Number.isFinite(edit) ? edit : data.pricing.edit;

    await writeData(data);

    return res.render('admin-dashboard', {
      data,
      error: null,
      success: 'تم تحديث الأسعار بنجاح.',
    });
  } catch (error) {
    const data = await readData();
    return res.render('admin-dashboard', {
      data,
      error: 'حدث خطأ أثناء تحديث الأسعار.',
      success: null,
    });
  }
});

app.use((req, res) => {
  res.status(404).render('not-found', { message: 'الصفحة غير موجودة.' });
});

async function startServer() {
  await ensureFiles();

  app.listen(PORT, () => {
    console.log(`خادم الموقع يعمل على: http://localhost:${PORT}`);
    console.log(`لوحة الإدارة: http://localhost:${PORT}/admin/login`);
  });
}

startServer().catch((error) => {
  console.error('فشل تشغيل الخادم:', error);
  process.exit(1);
});
