<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= category.name %> | <%= siteName %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <script defer src="/js/app.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container navbar">
        <div class="brand"><%= siteName %></div>
        <nav class="nav-links">
          <a href="/">الرئيسية</a>
          <a href="/artists">أصوات الفنانين</a>
          <a href="/pricing">الأسعار</a>
          <a href="/admin/login">لوحة التحكم</a>
        </nav>
      </div>
    </header>

    <main class="section">
      <div class="container">
        <h1 class="section-title"><%= category.name %></h1>

        <% if (category.files && category.files.length > 0) { %>
          <div class="audio-list">
            <% category.files.forEach(function(file) { %>
              <div class="audio-item">
                <h4><%= file.title %></h4>
                <audio controls src="<%= file.filePath %>"></audio>
                <div class="request-row">
                  <span class="tag">القسم: <%= category.name %></span>
                  <a class="btn primary" href="https://wa.me/<%= whatsappNumber %>?text=<%= encodeURIComponent('السلام عليكم، أود طلب الزفة: ' + category.name + ' - ' + file.title) %>" target="_blank" rel="noreferrer">طلب الآن</a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="card">
            <p>لا توجد ملفات صوتية في هذا القسم حالياً. يرجى العودة لاحقاً.</p>
          </div>
        <% } %>
      </div>
    </main>

    <footer class="footer">
      <div class="container">© <%= new Date().getFullYear() %> <%= siteName %></div>
    </footer>
  </body>
</html>
