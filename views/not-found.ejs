<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>لوحة التحكم | <%= siteName %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container navbar">
        <div class="brand"><%= siteName %></div>
        <nav class="nav-links">
          <a href="/">الرئيسية</a>
          <a href="/artists">أصوات الفنانين</a>
          <a href="/pricing">الأسعار</a>
          <a href="/admin/logout">تسجيل الخروج</a>
        </nav>
      </div>
    </header>

    <main class="section">
      <div class="container">
        <h1 class="section-title">لوحة تحكم المالك</h1>

        <% if (error) { %>
          <div class="alert error"><%= error %></div>
        <% } %>

        <% if (success) { %>
          <div class="alert success"><%= success %></div>
        <% } %>

        <div class="admin-grid">
          <section class="card">
            <h3>رفع ملف صوتي</h3>
            <form action="/admin/upload" method="POST" enctype="multipart/form-data" class="form-grid">
              <div>
                <label for="categoryId">اختر القسم</label>
                <select id="categoryId" name="categoryId" required>
                  <% data.categories.forEach(function(category) { %>
                    <option value="<%= category.id %>"><%= category.name %></option>
                  <% }); %>
                </select>
              </div>

              <div>
                <label for="title">اسم الزفة / الملف</label>
                <input id="title" name="title" type="text" placeholder="مثال: زفة عروس مميزة" required />
              </div>

              <div>
                <label for="audioFile">ملف صوتي</label>
                <input id="audioFile" class="file-input" name="audioFile" type="file" accept="audio/*" required />
              </div>

              <button type="submit" class="btn secondary">رفع الملف</button>
            </form>
          </section>

          <section class="card">
            <h3>تحديث الأسعار</h3>
            <form action="/admin/pricing" method="POST" class="form-grid">
              <div>
                <label for="newWords">كلمات جديدة</label>
                <input id="newWords" name="newWords" type="number" min="0" value="<%= data.pricing.newWords %>" required />
              </div>

              <div>
                <label for="edit">تعديل</label>
                <input id="edit" name="edit" type="number" min="0" value="<%= data.pricing.edit %>" required />
              </div>

              <button type="submit" class="btn primary">حفظ الأسعار</button>
            </form>
          </section>
        </div>

        <section class="card" style="margin-top: 24px;">
          <h3>الملفات المرفوعة في الأقسام</h3>
          <% data.categories.forEach(function(category) { %>
            <div style="margin-top: 18px;">
              <h4><%= category.name %></h4>
              <% if (category.files.length === 0) { %>
                <p>لا توجد ملفات في هذا القسم.</p>
              <% } else { %>
                <table class="table-list">
                  <thead>
                    <tr>
                      <th>اسم الملف</th>
                      <th>الملف الصوتي</th>
                      <th>الإجراء</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% category.files.forEach(function(file) { %>
                      <tr>
                        <td><%= file.title %></td>
                        <td><audio controls src="<%= file.filePath %>"></audio></td>
                        <td>
                          <form action="/admin/delete-audio" method="POST">
                            <input type="hidden" name="categoryId" value="<%= category.id %>" />
                            <input type="hidden" name="fileId" value="<%= file.id %>" />
                            <button type="submit" class="small-btn">حذف</button>
                          </form>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              <% } %>
            </div>
          <% }); %>
        </section>
      </div>
    </main>
  </body>
</html>
