<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>الأسعار | <%= siteName %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container navbar">
        <div class="brand"><%= siteName %></div>
        <nav class="nav-links">
          <a href="/">الرئيسية</a>
          <a href="/artists">أصوات الفنانين</a>
          <a href="/pricing">الأسعار</a>
          <a href="/admin/login">لوحة التحكم</a>
        </nav>
      </div>
    </header>

    <main class="section">
      <div class="container">
        <h1 class="section-title">الأسعار الحصرية</h1>
        <div class="pricing-box">
          <h3>خدمات الزفات</h3>
          <div class="price-list">
            <div class="price-row">
              <span>كلمات جديدة</span>
              <strong><%= pricing.newWords %> ريال</strong>
            </div>
            <div class="price-row">
              <span>تعديل</span>
              <strong><%= pricing.edit %> ريال</strong>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="footer">
      <div class="container">© <%= new Date().getFullYear() %> <%= siteName %></div>
    </footer>
  </body>
</html>
